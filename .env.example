# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
USE_X_FORWARDED_HOST=False

# Email verification / password reset
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Balloorina <yourgmail@gmail.com>
EMAIL_TIMEOUT=10
EMAIL_FAIL_SILENTLY=False

# Password reset limits
PASSWORD_RESET_TIMEOUT=1800
FORGOT_PASSWORD_RATE_LIMIT_PER_IP=5
FORGOT_PASSWORD_RATE_LIMIT_PER_EMAIL=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
FORGOT_PASSWORD_COOLDOWN_SECONDS=60

# Email-verification resend limits
EMAIL_VERIFICATION_TIMEOUT=86400
VERIFICATION_RESEND_RATE_LIMIT_PER_IP=5
VERIFICATION_RESEND_RATE_LIMIT_PER_EMAIL=3
VERIFICATION_RESEND_RATE_LIMIT_WINDOW_SECONDS=3600
VERIFICATION_RESEND_COOLDOWN_SECONDS=60


# Hugging Face
HUGGINGFACE_API_KEY=

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary media storage
# When CLOUDINARY_CLOUD_NAME is set, new FileField/ImageField uploads are stored
# on Cloudinary (persistent) instead of the local MEDIA_ROOT. Leave all three
# empty to fall back to serving the committed media/ folder locally.
# Find these under Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database (defaults to the local SQLite file db.sqlite3 when not set or empty).
# Local PostgreSQL example:
#   DATABASE_URL=postgres://postgres:your-password@localhost:5432/balloorina
# Railway provides this automatically when you attach a PostgreSQL service.
# An empty value on Railway (e.g. a ${{Service.VAR}} reference that failed to
# resolve) raises a RuntimeError instead of silently booting without a database.
DATABASE_URL=
