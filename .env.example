# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
USE_X_FORWARDED_HOST=False
# Maximum request body in bytes (25 MiB), including canvas JSON and preview.
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400

# All email: verification, password reset, bookings, payments, concerns, chat, policies.
# Brevo HTTPS API (not SMTP). See docs/email.md for setup and Railway Variables.
EMAIL_BACKEND=app.email_backend.BrevoEmailBackend
BREVO_API_KEY=
# Must match a sender verified in Brevo; replace before sending real email.
DEFAULT_FROM_EMAIL=Balloorina <verified-sender@your-domain.com>
EMAIL_TIMEOUT=10

# Password reset limits
PASSWORD_RESET_TIMEOUT=1800
FORGOT_PASSWORD_RATE_LIMIT_PER_IP=5
FORGOT_PASSWORD_RATE_LIMIT_PER_EMAIL=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
FORGOT_PASSWORD_COOLDOWN_SECONDS=60

# Email-verification resend limits
EMAIL_VERIFICATION_TIMEOUT=86400
# Email codes for signup and self-service password recovery (seconds).
EMAIL_OTP_TIMEOUT=600
EMAIL_OTP_RESET_TIMEOUT=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_ATTEMPT_WINDOW=600
EMAIL_OTP_VERIFY_PER_IP=30
VERIFICATION_RESEND_RATE_LIMIT_PER_IP=5
VERIFICATION_RESEND_RATE_LIMIT_PER_EMAIL=3
VERIFICATION_RESEND_RATE_LIMIT_WINDOW_SECONDS=3600
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Shared request protection (database-backed; run migrations before starting).
REQUEST_RATE_LIMITING_ENABLED=True
SUBMISSION_REPLAY_SECONDS=120
# Total multipart request size (32 MiB); per-field image validation still applies.
UPLOAD_MAX_REQUEST_BYTES=33554432
# Only list actual trusted reverse-proxy CIDRs. Empty ignores X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# Each policy supports RATE_LIMIT_<POLICY>_COUNT and
# RATE_LIMIT_<POLICY>_WINDOW_SECONDS. Defaults and policies: docs/request-protection.md
# Examples:
RATE_LIMIT_LOGIN_ACCOUNT_COUNT=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_BOOKING_CREATE_COUNT=5
RATE_LIMIT_BOOKING_CREATE_WINDOW_SECONDS=600
RATE_LIMIT_PAYMENT_SUBMIT_COUNT=5
RATE_LIMIT_PAYMENT_SUBMIT_WINDOW_SECONDS=600

# Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL_ID=Qwen/Qwen3-Next-80B-A3B-Instruct
HUGGINGFACE_TEXT_PROVIDER=auto
# Used only when a text model is unsupported, before any output is received.
HUGGINGFACE_TEXT_FALLBACK_MODELS=Qwen/Qwen3-4B-Instruct-2507
HUGGINGFACE_TEXT_TIMEOUT=25
AI_TEXT_RESPONSE_TIMEOUT_SECONDS=45
AI_TEXT_JOB_TIMEOUT_SECONDS=60
AI_SMART_ROUTING_ENABLED=True
AI_RELEVANCE_CHECK_ENABLED=True
# Optional JSON rates by model: input_per_million / output_per_million (USD).
AI_TEXT_PRICING_JSON={}
HUGGINGFACE_IMAGE_MODEL_ID=black-forest-labs/FLUX.1-schnell
# Revisions need access/credits for an image-editing provider/model.
AI_IMAGE_EDIT_MODEL_ID=black-forest-labs/FLUX.1-Kontext-dev
AI_IMAGE_EDIT_PROVIDER=auto
# Shared database queue; no Redis is required with the default web worker.
AI_WORKER_AUTOSTART=True
AI_JOB_LEASE_SECONDS=60
AI_JOB_TIMEOUT_SECONDS=900
AI_IMAGE_COOLDOWN_SECONDS=15
AI_IMAGE_DAILY_LIMIT=30
AI_CHAT_COOLDOWN_SECONDS=4

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary media storage
# When CLOUDINARY_CLOUD_NAME is set, new FileField/ImageField uploads are stored
# on Cloudinary (persistent) instead of the local MEDIA_ROOT. Leave all three
# empty to fall back to serving the committed media/ folder locally.
# Find these under Cloudinary Console > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database (defaults to the local SQLite file db.sqlite3 when not set or empty).
# Local PostgreSQL example:
#   DATABASE_URL=postgres://postgres:your-password@localhost:5432/balloorina
# Railway provides this automatically when you attach a PostgreSQL service.
# An empty value on Railway (e.g. a ${{Service.VAR}} reference that failed to
# resolve) raises a RuntimeError instead of silently booting without a database.
DATABASE_URL=
